{
  // Static site: Cloudflare only serves the files that `npm run build` writes to out/.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "happy-birthday-jasmine",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  // Keep request logs so a failure on her birthday can actually be looked at.
  // `persist` is left out on purpose: storing logs is a paid-plan feature and
  // the deploy is rejected without it.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
